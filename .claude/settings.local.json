{
  "permissions": {
    "allow": [
      "Bash",
      "Workflow",
      "Agent",
      "Task"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)"
    ],
    "ask": []
  },
  "enabledMcpjsonServers": [
    "playwright",
    "flowrunner-dev"
  ],
  "enableAllProjectMcpServers": true,
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "mcp__flowrunner-dev__.*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/automations/qa/mcp-flow-builder/tools/record-hook.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}