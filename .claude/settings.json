{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /Users/mark/dev/documentation/automations/hooks/doclint_on_edit.py"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 /Users/mark/dev/documentation/automations/hooks/session_standing_rules.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 /Users/mark/dev/documentation/automations/hooks/stop_drift_check.py"
          }
        ]
      }
    ]
  }
}
